# Copy to .env. VITE_* values are baked into the bundle at build time.

# Leave empty in development: Vite proxies /api to http://localhost:3000.
# In production set the full API base including /api, e.g. https://api.example.com/api
VITE_API_URL=

# Error tracking (Sentry). Off when empty; baked in at build time.
VITE_SENTRY_DSN=
