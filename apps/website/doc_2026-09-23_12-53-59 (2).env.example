NEXT_PUBLIC_API_URL=http://localhost:3000
# Admin management lives in apps/dashboard; the storefront only links out to it.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
# Optional, server-only: backend base the Next auth route handlers
# (src/app/api/auth/*) call directly, e.g. an internal Docker/Render hostname.
# Falls back to NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=http://localhost:3000
# Dev only: let the checkout page place orders directly when Stripe is not configured.
NEXT_PUBLIC_ALLOW_CHECKOUT_WITHOUT_STRIPE=false
