# Copy to .env.local. NEXT_PUBLIC_* values are baked into the client bundle at build time.

# API origin, no trailing slash and no /api. next.config.ts rewrites /api/* here.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional: API origin for server-side fetches (metadata, sitemap, auth checks) when
# the server reaches the API on a private address. Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Public storefront origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Admin dashboard origin, linked from the account menu for admins.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002

# Set when the API uses STORAGE_DRIVER=cloudinary so next/image may load
# res.cloudinary.com/<cloud name>/** (next.config.ts images.remotePatterns).
CLOUDINARY_CLOUD_NAME=

# Dev only: place orders without Stripe. Must match the API's DEV_ALLOW_DIRECT_ORDERS.
NEXT_PUBLIC_ALLOW_CHECKOUT_WITHOUT_STRIPE=false
