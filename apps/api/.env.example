# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=trendvaulta

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
# Any long random string. Rotating this invalidates all existing sessions.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- CORS ---
# Exact origins allowed to call the API in production (comma-separated extra origins).
FRONTEND_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3002
ALLOWED_ORIGINS=
# Set to 'true' only for temporary local debugging against a deployed API.
CORS_RELAXED=false

# --- Rate limiting ---
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PASSWORD_MAX=10
RATE_LIMIT_REFRESH_MAX=120
# Checkout success-page polling of POST /api/payments/verify-payment (per IP / 15 min).
RATE_LIMIT_VERIFY_MAX=120
# Public cart/checkout quotes via POST /api/payments/quote (per IP / 15 min).
RATE_LIMIT_QUOTE_MAX=120
# Checkout-session creation via POST /api/payments/checkout-session (per IP / 15 min).
RATE_LIMIT_CHECKOUT_MAX=40
# Coupon validation via POST /api/coupons/validate (per IP / 15 min).
RATE_LIMIT_COUPON_MAX=60

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Fallback storefront origin for Stripe Checkout success/cancel URLs when FRONTEND_URL is unset.
PUBLIC_FRONTEND_URL=
# When an admin cancels/refunds a paid order, create the Stripe refund automatically.
# Set to 'false' to skip the API call; such orders are then flagged
# attentionReason=manual_refund_required for a manual refund in the Stripe dashboard.
AUTO_REFUND_ON_CANCEL=true

# --- Shipping ---
# Flat shipping fee in USD applied when shippingMethod is standard/express.
SHIPPING_FLAT_USD=5

# --- Email (password reset / order confirmation) ---
# Preferred: SMTP_* (used first if SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Fallback if SMTP_* is not set:
EMAIL_USER=
EMAIL_PASSWORD=
# Legacy alias for EMAIL_PASSWORD (utils/mail.js reads either).
EMAIL_PASS=
# Sender address for outgoing mail (falls back to SMTP_USER, then EMAIL_USER).
FROM_EMAIL=
# Inbox that receives contact-form notifications (falls back to SMTP_USER, then EMAIL_USER).
CONTACT_INBOX_EMAIL=

# --- Shutdown ---
# Milliseconds to let in-flight requests finish on SIGTERM/SIGINT before
# the process is forced down (app.js).
SHUTDOWN_GRACE_MS=10000

# --- Seeder (node seeder.js -import) ---
# Optional: create/promote an admin account during import.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

# --- Uploads ---
# Product/brand image uploads (POST /api/uploads). Default: local disk (apps/api/uploads/).
# Set Cloudinary credentials to use CDN storage (recommended for production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: set this once uploads move behind a CDN; when unset, URLs use this API's own request origin.
UPLOAD_PUBLIC_BASE_URL=

# --- Misc ---
# Dev-only escape hatches — never enable in production.
DEV_ALLOW_DIRECT_ORDERS=false
ALLOW_DIRECT_ORDERS=false
# Test suite only: external Mongo URI (defaults to mongodb-memory-server when unset).
MONGO_TEST_URL=
